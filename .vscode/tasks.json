{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start AgriGO PostgreSQL",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\.vscode\\start-postgresql.ps1"
			],
			"problemMatcher": []
		},
		{
			"label": "Run AgriGO Backend",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"main:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": [],
			"dependsOn": "Start AgriGO PostgreSQL",
			"dependsOrder": "sequence",
			"options": {
				"cwd": "${workspaceFolder}\\backend"
			}
		}
	]
}